generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  INCOME      // Thu nhập
  EXPENSE     // Chi tiêu
  TRANSFER    // Chuyển khoản giữa các ví
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}


enum TransactionStatus {
  PENDING     // Đang xử lý
  COMPLETED   // Hoàn thành
  CANCELLED   // Đã hủy
  FAILED      // Thất bại
}

enum CategoryType {
  INCOME      // Danh mục thu nhập
  EXPENSE     // Danh mục chi tiêu
}

enum WalletType {
  CASH        // Tiền mặt
  BANK        // Tài khoản ngân hàng
  E_WALLET    // Ví điện tử (Momo, ZaloPay, PayPal)
  CREDIT      // Thẻ tín dụng
  INVESTMENT  // Đầu tư
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum GoalStatus {
  IN_PROGRESS  // Đang thực hiện
  COMPLETED    // Hoàn thành
  CANCELLED    // Đã hủy
  PAUSED       // Tạm dừng
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DebtType {
  LOAN  // Khoản vay (mình vay)
  DEBT  // Khoản nợ (người khác nợ mình)
}

enum DebtStatus {
  ACTIVE     // Đang hoạt động
  PAID       // Đã thanh toán xong
  OVERDUE    // Quá hạn
  CANCELLED  // Đã hủy
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
  OTHER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Currency {
  VND
  USD
  EUR
  GBP
  JPY
  CNY
  KRW
  AUD
  CAD
  CHF
  SEK
  NOK
  DKK
  NZD
  SGD
  HKD
  TWD
}

enum BudgetType {
  SPENDING
  INCOME
}

enum AttachmentType {
  IMAGE
  PDF
  DOCUMENT
}

enum LanguageCode {
  VI
  EN
}

enum AuditAction {
  LOGIN
  LOGOUT

  CREATE
  UPDATE
  DELETE
  RESTORE

  CHANGE_PASSWORD
  RESET_PASSWORD

  VERIFY_EMAIL
}

// ============================================
// MODELS
// ============================================

model User {
  id       String @id @default(uuid())

  // Thông tin đăng nhập
  email    String @unique
  password  String?
  name     String

  // Trạng thái tài khoản
  status   UserStatus @default(PENDING)
  role     Role    @default(USER)

  // Đăng nhập bằng mạng xã hội
  provider  AuthProvider @default(LOCAL)
  providerId String?
  avatar   String?

  
  // Xác thực email
  verifyToken String?
  verifiedAt DateTime?   @db.Timestamptz(6)
  verifyTokenExpiresAt DateTime? @db.Timestamptz(6)
 
  tokenVersion  Int @default(0)
  deletedAt DateTime?

  // Quên mật khẩu
  resetToken           String?   @unique
  resetTokenExpiresAt  DateTime? @db.Timestamptz(6)

  // Múi giờ
  timezone String @default("Asia/Ho_Chi_Minh")



  // Thời gian
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  sessions UserSession[]
  wallets Wallet[]
  categories Category[]
  transactions Transaction[]
  budgets Budget[]
  recurringTransactions RecurringTransaction[]
  goals Goal[]
  debts Debt[]
  notifications Notification[]
  tags Tag[]
  auditLogs AuditLog[]
  preferences UserPreference?

  // Indexes
  @@unique([provider, providerId])
  @@index([role])
  @@index([timezone])
  @@index([status])
  @@index([createdAt])
}

model UserPreference {
  id String @id @default(uuid())

  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  language LanguageCode @default(EN)
  currency Currency @default(VND)
  theme String @default("system")

  weekStartsOn Int @default(1) // 0: Sunday, 1: Monday
  dateFormat String @default("DD/MM/YYYY")
  timeFormat String @default("24h")

  budgetNotification Boolean @default(true)
  goalNotification Boolean @default(true)
  debtNotification Boolean @default(true)
  recurringNotification Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model UserSession {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String @unique
  userAgent String?
  ipAddress String?
  isRemember    Boolean  @default(false)

  lastLoginAt DateTime @default(now()) @db.Timestamptz(6)
  lastActiveAt DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([lastActiveAt])
}

// ============================================
// CATEGORY MODEL
// ============================================

model Category {
  id          String       @id @default(uuid())
  name        String
  icon        String?
  color       String?
  type        CategoryType
  
  userId      String? 
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  parentId    String?
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  
  isSystem    Boolean      @default(false)
  
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?    @db.Timestamptz(6)
  
  transactions Transaction[]
  budgets Budget[]
  recurringTransactions RecurringTransaction[]
  
  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@unique([userId, name, type])
  @@index([parentId])
}

// ============================================
// WALLET MODEL
// ============================================

model Wallet {
  id          String      @id @default(uuid())
  name        String
  type        WalletType
  balance     Decimal     @db.Decimal(18,2) @default(0)
  currency    Currency    @default(VND)  // SỬA: bỏ Currency.
  icon        String?
  color       String?
  
  initialBalance Decimal @db.Decimal(18,2) @default(0)
  
  bankName    String?
  accountNumber String?
  accountName  String?
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isDefault   Boolean     @default(false)
  isArchived  Boolean     @default(false)
  
  autoSync    Boolean     @default(true)
  description String?
  
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?   @db.Timestamptz(6)
  archivedAt  DateTime?   @db.Timestamptz(6)
  
  transactions     Transaction[]
  fromTransactions Transaction[] @relation("FromWallet")
  toTransactions   Transaction[] @relation("ToWallet")
  recurringTransactions RecurringTransaction[]
  goals Goal[]
  debts Debt[]
  goalContributions GoalContribution[]

  
  @@index([userId])
  @@index([userId, isDefault])
  @@index([type])
  @@unique([userId, name])
}

// ============================================
// TRANSACTION MODEL
// ============================================
model Transaction {
  id          String      @id @default(uuid())
  
  type        TransactionType
  amount      Decimal     @db.Decimal(18,2)
  currency    Currency    @default(VND)
  
  description String?
  note        String?
  
  date        DateTime    @default(now()) @db.Timestamptz(6)
  
  status      TransactionStatus @default(COMPLETED)
  
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  walletId    String?
  wallet      Wallet?     @relation(fields: [walletId], references: [id], onDelete: SetNull)
  
  fromWalletId String?
  toWalletId   String?
  fromWallet   Wallet?    @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: SetNull)
  toWallet     Wallet?    @relation("ToWallet", fields: [toWalletId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  metadata    Json?
  reference   String?
  
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?   @db.Timestamptz(6)

  
  debts        Debt[]
  debtPayments DebtPayment[]
  goalContributions GoalContribution[]
  transactionTags TransactionTag[]
  attachments TransactionAttachment[]
  
  @@index([userId])
  @@index([walletId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([status])
  @@index([deletedAt]) 
  @@index([fromWalletId])           
  @@index([toWalletId])            
  @@index([reference])        
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, walletId])
  @@index([userId, categoryId])
  @@index([userId, date, type])
  @@index([userId, status, date])
}

enum NotificationType {
  BUDGET
  GOAL
  DEBT
  RECURRING
  SYSTEM
}

model Notification {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String
  message String

  isRead Boolean @default(false)

  metadata Json?

  readAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId]) 
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([userId, isRead])
}

// ============================================
// BUDGET MODEL
// ============================================
model Budget {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  amount      Decimal  @db.Decimal(18,2)
  spent       Decimal  @db.Decimal(18,2) @default(0)  // THÊM
  
  startDate   DateTime @db.Timestamptz(6) 
  endDate     DateTime @db.Timestamptz(6)
  
  period      BudgetPeriod @default(MONTHLY)
  type        BudgetType @default(SPENDING)  
  
  alertThreshold Decimal? @db.Decimal(18,2)
  isAlertEnabled Boolean  @default(false)
  
  description String?
  notes       String? 
  isActive    Boolean @default(true)
  
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  
  @@index([userId])
  @@index([categoryId])
  @@index([userId, categoryId])
  @@index([startDate, endDate])
  @@index([isActive])  
  @@index([period])    
  @@index([deletedAt]) 
  @@unique([userId, categoryId, startDate, endDate])
}

// ============================================
// RECURRING TRANSACTION MODEL
// ============================================

model RecurringTransaction {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  name        String
  amount      Decimal  @db.Decimal(18,2)
  type        TransactionType
  currency    Currency @default(VND)  // THÊM
  
  frequency   RecurringFrequency
  interval    Int      @default(1)
  
  startDate   DateTime @db.Timestamptz(6)
  endDate     DateTime? @db.Timestamptz(6)
  lastRunDate DateTime?
  
  nextRunDate DateTime @db.Timestamptz(6)
  
  isActive    Boolean  @default(true)
  
  description String?
  metadata    Json?
  
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  
  @@index([userId])
  @@index([walletId])
  @@index([categoryId])
  @@index([nextRunDate])
  @@index([isActive])
  @@index([userId, isActive])
  @@index([userId, nextRunDate])
  @@index([frequency])  // THÊM
  @@index([type])       // THÊM
  @@index([deletedAt])  // THÊM
}

model Tag {
  id String @id @default(uuid())

  name String
  color String?
  icon String?

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  transactionTags TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}


model TransactionTag {

  transactionId String
  tagId String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([transactionId, tagId])

  @@index([transactionId])
  @@index([tagId])
}


model TransactionAttachment {

  id String @id @default(uuid())

  transactionId String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  fileName String

  fileUrl String

  mimeType String?

  fileSize Int?

  type AttachmentType @default(IMAGE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([transactionId])
}

// ============================================
// GOAL MODEL
// ============================================

model Goal {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  targetAmount Decimal @db.Decimal(18,2)
  savedAmount Decimal @db.Decimal(18,2) @default(0)
  
  currency    Currency @default(VND)  // THÊM
  
  startDate   DateTime @db.Timestamptz(6)
  targetDate  DateTime @db.Timestamptz(6)
  
  status      GoalStatus @default(IN_PROGRESS)
  priority    GoalPriority @default(MEDIUM)
  
  description String?
  notes       String?  // THÊM
  icon        String?
  color       String?
  
  isArchived Boolean @default(false)
  
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  
  
  reminderDate DateTime? @db.Timestamptz(6)  // THÊM
  reminderSent Boolean @default(false)       // THÊM


  contributions GoalContribution[]
  
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  archivedAt  DateTime? @db.Timestamptz(6)
  
  @@index([userId])
  @@index([status])
  @@index([targetDate])
  @@index([userId, status])
  @@index([priority])    // THÊM
  @@index([isArchived])  // THÊM
  @@index([deletedAt])   // THÊM
}


model GoalContribution {
  id String @id @default(uuid())

  goalId String
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  walletId String?
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(18,2)

  contributionDate DateTime @default(now()) @db.Timestamptz(6)

  note String?

  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([goalId])
  @@index([walletId])
  @@index([transactionId])
  @@index([contributionDate])
}


// ============================================
// DEBT/LOAN MODEL
// ============================================

model Debt {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  type        DebtType @default(LOAN)
  
  totalAmount Decimal  @db.Decimal(18,2)
  paidAmount  Decimal  @db.Decimal(18,2) @default(0)
  // remainingAmount sẽ tính toán từ totalAmount - paidAmount
  
  currency    Currency @default(VND)  // THÊM
  
  interestRate Decimal? @db.Decimal(5,2)
  
  startDate   DateTime @db.Timestamptz(6)
  dueDate     DateTime @db.Timestamptz(6)
  
  monthlyPayment Decimal? @db.Decimal(18,2)
  
  status      DebtStatus @default(ACTIVE)
  
  description String?
  contactName String?
  borrower String?
  
  accountNumber String?
  
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  
  note        String?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  
  reminderDate DateTime? @db.Timestamptz(6)  // THÊM
  reminderSent Boolean @default(false)       // THÊM
  
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  
  payments    DebtPayment[]
  
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([userId, status])
  @@index([type])        // THÊM
  @@index([walletId])    // THÊM
  @@index([deletedAt])   // THÊM
}

// ============================================
// DEBT PAYMENT MODEL
// ============================================

model DebtPayment {
  id          String   @id @default(uuid())
  
  debtId      String
  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  
  amount      Decimal  @db.Decimal(18,2)
  paymentDate DateTime @db.Timestamptz(6)
  
  method      PaymentMethod @default(CASH)
  note        String?
  
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  
  @@index([debtId])
  @@index([paymentDate])
  @@index([createdAt])  // THÊM
}

model AuditLog {

  id String @id @default(uuid())

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  entity String

  entityId String?

  ipAddress String?

  userAgent String?

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}