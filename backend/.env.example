# ==========================================
# 1. CẤU HÌNH CHUNG (APP CONFIG)
# ==========================================
NODE_ENV=development
PORT=8080
MAX_WALLETS_PER_USER=5

# ==========================================
# 2. CƠ SỞ DỮ LIỆU (DATABASE)
# ==========================================
# Dùng localhost:5433 khi chạy Docker Compose
DATABASE_URL="postgresql://postgres:123456@localhost:5433/db_postgres?schema=public"

# ==========================================
# 3. REDIS (CACHE/QUEUE)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ==========================================
# 4. BẢO MẬT & JWT (AUTHENTICATION)
# ==========================================
JWT_ACCESS_SECRET=replace_with_a_strong_random_string
JWT_REFRESH_SECRET=replace_with_another_strong_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# 5. GOOGLE OAUTH (ĐĂNG NHẬP MẠNG XÃ HỘI)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ==========================================
# 6. CẤU HÌNH EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=BudgetFlow
FRONTEND_URL=http://localhost:3000