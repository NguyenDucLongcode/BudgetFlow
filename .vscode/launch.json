{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend - NestJS",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:debug",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend - Next.js",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend - Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    }
  ],
  "compounds": [
    {
      "name": "🚀 BudgetFlow - Full Stack",
      "configurations": [
        "Backend - NestJS",
        "Frontend - Next.js",
        "Frontend - Browser"
      ],
      "stopAll": true
    }
  ]
}
